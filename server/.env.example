PORT=5000
NODE_ENV=development
# Supply the authorized connection string privately; this placeholder is not runnable.
MONGODB_URI=REPLACE_WITH_MONGODB_URI
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated explicit origins; production uses ONLY this list (HTTPS).
# CLIENT_ORIGIN=https://menu.example.com
# Development only: localhost and this computer's private interface addresses.
DEV_CLIENT_PORTS=5173,5174
DEV_ALLOW_LAN=true
# Optional exact local origins, e.g. a .local hostname; no wildcard/public hosts.
DEV_CLIENT_ORIGINS=
# Number of trusted reverse proxies; leave 0 for direct connections.
TRUST_PROXY=0
# Set true on the unified Render web service after building the root dist/ directory.
SERVE_FRONTEND=false
# Optional: Cloudinary configuration for remote media storage (defaults to local persistent storage in public/uploads if omitted)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Web Push VAPID credentials (generate using: npm run generate:vapid)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@family-restaurant.local
