{
  "name": "family-restaurant-menu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c red,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "npm run dev --workspace server",
    "start:server": "npm start --workspace server",
    "seed": "npm run seed --workspace server",
    "create-admin": "npm run create-admin --workspace server",
    "generate:vapid": "npm run generate:vapid --workspace server",
    "check:db": "npm run check:db --workspace server",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js server/tests/*.test.js",
    "test:server": "node --test server/tests/*.test.js",
    "test:ui": "node scripts/test-ui.mjs",
    "test:production": "node scripts/test-ui.mjs --production"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
